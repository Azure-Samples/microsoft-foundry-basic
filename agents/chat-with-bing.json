{
  "definition": {
    "kind": "hosted",
    "code_configuration": {
      "runtime": "dotnet_10",
      "entry_point": ["dotnet", "agent.dll"],
      "dependency_resolution": "bundled"
    },
    "cpu": "1",
    "memory": "2Gi",
    "protocol_versions": [
      {"protocol": "responses", "version": "2.0.0"}
    ],
    "environment_variables": {
      "AZURE_AI_MODEL_DEPLOYMENT_NAME": "agent-model",
      "BING_CONNECTION_NAME": "bingaiagent"
    }
  }
}
