# Deployment configuration template
# Copy to deploy-infra.local.env and update with your values
# deploy-infra.local.env is NOT tracked by git (see .gitignore)

SUBSCRIPTION_ID=
TENANT_ID=

# Base name for Azure resource naming (6-8 lowercase chars, must be globally unique for DNS names)
BASE_NAME=aitr7631

# Azure region
LOCATION=swedencentral

# Resource group name (follows naming convention: rg-{project}-{env}-{region}-{instance})
RESOURCE_GROUP=rg-ai-translator-dev-swe-001

# App Service authentication providers. Store both client secrets in the deployed Key Vault;
# only secret names are configured here. The Microsoft registration must allow organizational
# and personal Microsoft accounts. Google must allow the app's /.auth/login/google/callback URI.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET_NAME=microsoft-login-client-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_NAME=google-login-client-secret

# Target production architecture uses Table Storage only.
RETAIN_POSTGRES=true

# Target production architecture uses public endpoints secured with TLS, managed identity,
# RBAC, and disabled local/shared-key authentication. Bicep defaults remain private.
ENABLE_PRIVATE_NETWORKING=true

