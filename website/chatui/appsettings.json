{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "AIProjectEndpoint": "https://<foundryaccount-customsubdomain-name>.services.ai.azure.com/api/projects/<foundry-project-name>",
  "AIAgentId": "",
  "AIAgentVersion": "",
  "FoundryVoiceEnabled": false,
  "FoundryVoiceAgentName": "agent-aitr-prod-swe-001",
  "Translator": {
    "Endpoint": "https://<translator-account>.cognitiveservices.azure.com/",
    "Region": "swedencentral"
  },
  "Speech": {
    "Endpoint": "https://<region>.api.cognitive.microsoft.com/",
    "Region": "swedencentral",
    "ResourceId": "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<speech-account>"
  },
  "WebPubSub": {
    "Endpoint": "https://<wps-account>.webpubsub.azure.com",
    "Hub": "meetings",
    "ClientTokenLifetimeMinutes": 60
  },
  "KeyVault": {
    "Uri": "https://<kv-name>.vault.azure.net/",
    "JoinTokenSigningKeySecretName": "join-token-signing-key"
  },
  "JoinToken": {
    "Audience": "meeting-join",
    "LifetimeHours": 24
  },
  "TableStorage": {
    "Endpoint": "https://<storage-account>.table.core.windows.net/",
    "UsersTableName": "users",
    "UserInvitesTableName": "userinvites"
  }
}