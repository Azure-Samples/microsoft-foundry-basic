{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "AIProjectEndpoint": "https://<foundryaccount-customsubdomain-name>.services.ai.azure.com/api/projects/<foundry-project-name>",
  "AIAgentId": "",
  "AIAgentVersion": "",
  "Translator": {
    "Endpoint": "https://<translator-account>.cognitiveservices.azure.com/",
    "Region": "swedencentral"
  },
  "SpeechEndpoint": "https://<region>.api.cognitive.microsoft.com/",
  "SpeechRegion": "swedencentral",
  "SpeechResourceId": "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<speech-account>",
  "WebPubSubEndpoint": "https://<wps-account>.webpubsub.azure.com",
  "WebPubSubHub": "meetings",
  "KeyVaultUri": "https://<kv-name>.vault.azure.net/",
  "JoinTokenSigningKeySecretName": "join-token-signing-key",
  "Postgres": {
    "Host": "<pg-name>.postgres.database.azure.com",
    "Database": "translator",
    "Username": "<app-service-managed-identity-client-id>"
  }
}